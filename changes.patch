+async fn fetch_manifest_body(client: &reqwest::Client) -> Result<String, AppError> {
+    let body = client
+        .get(MANIFEST_URL)
+        .send()
+        .await?
+        .error_for_status()
+        .map_err(AppError::from)?
+        .text()
